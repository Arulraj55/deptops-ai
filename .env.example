# Copy this file to .env and fill in your credentials

# --- OpenRouter API ---
# Models are configured in config.py, not in .env.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Neon PostgreSQL ---
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Local storage paths (ephemeral / in-memory fallback) ---
CHROMA_PERSIST_DIR=/tmp/deptops/chroma_db
ANALYTICS_DATA_DIR=/tmp/deptops/analytics
DOCUMENTS_DIR=/tmp/deptops/documents
